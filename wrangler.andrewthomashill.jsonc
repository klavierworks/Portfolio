// Worker for andrewthomashill.co.uk. Deploy with: npx wrangler deploy -c wrangler.andrewthomashill.jsonc
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "andrewthomashill-portfolio",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "build": {
    "command": "npm run build:andrewthomashill"
  },
  "assets": {
    "directory": "dist/andrewthomashill",
    "binding": "ASSETS"
  },
  "vars": {
    "PLAUSIBLE_DOMAIN": "andrewthomashill.co.uk"
  },
  "routes": [
    { "pattern": "andrewthomashill.co.uk", "custom_domain": true }
  ]
}
