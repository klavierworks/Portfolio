{
  "name": "andrewhill-portfolio",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "build:andrewthomashill": "SITE_VARIANT=andrewthomashill astro build --outDir dist/andrewthomashill",
    "build:klavierworks": "SITE_VARIANT=klavierworks astro build --outDir dist/klavierworks",
    "build:all": "astro check && npm run build:andrewthomashill && npm run build:klavierworks",
    "preview": "astro preview",
    "deploy:andrewthomashill": "wrangler deploy -c wrangler.andrewthomashill.jsonc",
    "deploy:klavierworks": "wrangler deploy -c wrangler.klavierworks.jsonc",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/check": "0.9.3",
    "@astrojs/react": "3.6.3",
    "@react-three/drei": "10.3.0",
    "@react-three/fiber": "9.1.2",
    "@react-three/postprocessing": "3.0.4",
    "@types/node": "20.16.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "astro": "4.15.3",
    "ff8": "https://github.com/klavierworks/ff8/releases/download/v0.1.5/ff8-0.1.5.tgz",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "three": "0.177.0",
    "typescript": "5.5.4"
  },
  "devDependencies": {
    "postcss-mixins": "10.0.1",
    "postcss-preset-env": "10.0.2",
    "wrangler": "4.145.0"
  }
}
