---
import Caption from './Caption/Caption.astro';
import GlowFilter from './GlowFilter/GlowFilter.astro';
import Noise from './Noise/Noise.astro';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const filterId = `old-display-${Math.random().toString(36).slice(2, 10)}`;
---

<old-display
  class={className}
  style={`--filter: url(#${filterId});`}
>
  <div class="picture">
    <Caption><slot /></Caption>
    <Noise />
  </div>
  <GlowFilter id={filterId} />
</old-display>

<style>
  old-display {
    /* Sized to the text, with the caption's bleed for the glow pulled back out so the words sit where the element is placed */
    --bleed: 0.5em;
    display: block;
    position: relative;
    width: fit-content;
    margin: calc(-1 * var(--bleed));
    overflow: hidden;
    background: rgb(var(--background-color));
  }

  .picture {
    position: relative;
    width: max-content;
    overflow: hidden;
    transform-origin: 0 0;
    will-change: transform;
    background: rgb(var(--background-color));
  }
</style>

<script>
  import { OldDisplay } from './OldDisplay';

  if (!customElements.get('old-display')) customElements.define('old-display', OldDisplay);
</script>
