---
import AstonMachineText from '../components/AstonMachineText/AstonMachineText.astro';
import TheRear from '../components/TheRear/TheRear';
import site from '../data/sites';
---

<html lang="en" class="no-js">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{site.title}</title>
    <script type="text/javascript">
      document.documentElement.classList.remove('no-js');
    </script>
    <script>
      import { logClicks, logPageView } from '../utils.ts';
      logPageView();
      logClicks();
    </script>
	</head>
	<body>
    <div class="overlay" id="overlay">
      <AstonMachineText class="aston">
        <p>{site.intro[0]}<br />{site.intro[1]}</p>
        <p>Recent commercial work  for Apple,<br />Prada, Lexus, Boucheron, and Nike.</p>
        <p><a href="mailto:contact@klavier.works">Get in touch.</a></p>
      </AstonMachineText>
    </div>
    <TheRear client:only="react" overlayId="overlay" />
	</body>
</html>

<style>

  * {
    box-sizing: border-box;
  }

  :root {
    --background-color: 4 4 3;
    --text-color: 220 220 212;
    --letter-spacing: -0.055em;
  }
  
  body {
    font-family: Helvetica, Arial, sans-serif;
    font-size: 32px;
    font-weight: 700;
    line-height: 1.28;
    letter-spacing: var(--letter-spacing);

    color: rgb(var(--text-color));
    background-color: rgb(var(--background-color));
    margin: 0;
  }

  .overlay {
    position: fixed;
    inset: 0;
    z-index: 1;
    overflow: auto;
    padding: 14.5vw 5.5vw 0;
    background-color: rgb(var(--background-color));

    > :global(*) {
      transition: opacity 600ms ease-out;
    }

    &:global(.isFading) > :global(*) {
      opacity: 0;
    }

    &:global(.isHidden) {
      display: none;
    }
  }

  :global(.aston) {
    --word-spacing: -0.036em;
  }
</style>
