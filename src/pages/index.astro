---
import AstonMachineText from '../components/AstonMachineText/AstonMachineText.astro';
import site from '../data/sites';
---

<html lang="en" class="no-js">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{site.title}</title>
    <script type="text/javascript">
      document.documentElement.classList.remove('no-js');
    </script>
	</head>
	<body>
    <AstonMachineText class="aston">
      <p>{site.intro[0]}<br />{site.intro[1]}</p>
      <p>Recent commercial work  for Apple,<br />Prada, Lexus, Boucheron, and Nike.</p>
      <p><a href="mailto:contact@klavier.works">Get in touch.</a></p>
    </AstonMachineText>
	</body>
</html>

<style>

  * {
    box-sizing: border-box;
  }

  :root {
    --background-color: 4 4 3;
    --text-color: 220 220 212;
    --letter-spacing: -0.02em;
  }
  
  body {
    font-family: Helvetica, Arial, sans-serif;
    font-size: 32px;
    line-height: 1.213;
    letter-spacing: var(--letter-spacing);

    color: rgb(var(--text-color));
    background-color: rgb(var(--background-color));
    margin: 0;
  }

  :global(.aston) {
    --text-left: 5.5vw;
    --text-top: 14.5vw;
    --word-spacing: -0.036em;
  }
</style>
