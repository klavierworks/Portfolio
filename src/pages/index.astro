---
import AstonMachineText from '../components/AstonMachineText/AstonMachineText.astro';
import site from '../data/sites';
---

<html lang="en" class="no-js">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{site.title}</title>
    <script type="text/javascript">
      document.documentElement.classList.remove('no-js');
    </script>
    <script>
      import { logClicks, logPageView } from '../utils.ts';
      logPageView();
      logClicks();
    </script>
	</head>
	<body>
    <div class="rear" data-rear></div>
    <div class="overlay" data-rear-overlay>
      <AstonMachineText class="aston">
        <p>{site.intro[0]}<br />{site.intro[1]}</p>
        <p>Recent commercial work  for Apple,<br />Prada, Lexus, Boucheron, and Nike.</p>
        <p><a href="mailto:contact@klavier.works">Get in touch.</a></p>
      </AstonMachineText>
      <div class="status" data-rear-status data-state="loading">
        <AstonMachineText class="aston">
          <p><span class="loading"><span class="dot">.</span><span class="dot">.</span><span class="dot">.</span></span><a class="close" href="#" data-rear-close>x</a></p>
        </AstonMachineText>
      </div>
    </div>
    <div class="return" data-rear-return hidden>
      <AstonMachineText class="aston">
        <p><a class="close" href="#" data-rear-return-link>Return</a></p>
      </AstonMachineText>
    </div>
    <script>
      import { scheduleTheRear } from '../components/TheRear/scheduleTheRear';
      scheduleTheRear();
    </script>
	</body>
</html>

<style>

  * {
    box-sizing: border-box;
  }

  :root {
    --background-color: 4 4 3;
    --text-color: 220 220 212;
    --letter-spacing: -0.055em;
  }
  
  body {
    font-family: Helvetica, Arial, sans-serif;
    font-size: 24px;
    font-weight: 700;
    line-height: 1.28;
    letter-spacing: var(--letter-spacing);

    color: rgb(var(--text-color));
    background-color: rgb(var(--background-color));
    margin: 0;

    @media (min-width: 600px) {
      font-size: 32px;
    }
  }

  .overlay {
    position: fixed;
    inset: 0;
    z-index: 1;
    overflow: auto;
    padding: 0 5.5vw;
    background-color: rgb(var(--background-color));

    /* The free height is split a third above the text and two thirds below */
    display: flex;
    flex-direction: column;
    align-items: flex-start;

    /* display: flex would otherwise override the hidden attribute TheRear uses to reveal FF8 */
    &[hidden] {
      display: none;
    }

    &::before {
      content: '';
      flex: 1 0 0;
    }

    &::after {
      content: '';
      flex: 2 0 0;
    }
  }

  .rear {
    position: fixed;
    inset: 0;
    z-index: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: black;
  }

  .status {
    position: absolute;
    top: 5.5vw;
    right: 5.5vw;

    &[data-state='loading'] .close,
    &[data-state='ready'] .loading {
      display: none;
    }
  }

  .return {
    --background-color: 0 0 0;
    position: fixed;
    top: 5.5vw;
    right: 5.5vw;
    z-index: 2;
  }

  /* Scoped under each container so it outranks AstonMachine's own link underline */
  .status .close,
  .status .close :global(.ink),
  .return .close,
  .return .close :global(.ink) {
    text-decoration: none;
  }

  /* The dots stay laid out while hidden, so the text never changes width and the picture is not re-measured */
  .dot:nth-child(2) {
    animation: dot-two 1.2s infinite;
  }

  .dot:nth-child(3) {
    animation: dot-three 1.2s infinite;
  }

  @keyframes dot-two {
    0%, 33.3% { visibility: hidden; }
    33.4%, 100% { visibility: visible; }
  }

  @keyframes dot-three {
    0%, 66.6% { visibility: hidden; }
    66.7%, 100% { visibility: visible; }
  }

  :global(.aston) {
    --word-spacing: -0.036em;
  }
</style>
